# ============================================================================
# 1. BANCO DE DADOS (PostgreSQL Local via Docker ou Supabase)
# ============================================================================
# Opção A — Docker Compose Local:
DATABASE_URL="postgresql://skillswap:skillswap_secret@localhost:5433/skillswap_db?schema=public"

# Opção B — Supabase (Transaction Pooler porta 6543 + Direct Connection porta 5432):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ============================================================================
# 2. AUTENTICAÇÃO & SEGURANÇA (JWT Cookie HttpOnly)
# ============================================================================
# Gere um segredo forte com: openssl rand -base64 32
JWT_SECRET="skillswap-academic-super-secret-jwt-key-2026-change-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================================
# 3. INTEGRAÇÃO GOOGLE CALENDAR API (Opcional - Fallback .ICS & Deep Link ativos)
# ============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/callback"
GOOGLE_REFRESH_TOKEN=""
